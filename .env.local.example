# Copy to .env.local. Never commit the real file.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY. Never prefix with NEXT_PUBLIC_.
OPS_KEY=                            # long random string; gates /ops and /api/export
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=     # reCAPTCHA v2 "I'm not a robot" checkbox
RECAPTCHA_SECRET_KEY=               # SERVER ONLY

# Used by scripts/seed_participants.ts to print the paper strips, and by
# scripts/loadtest.ts as the target origin. Not read by the app itself.
APP_URL=http://localhost:3000
